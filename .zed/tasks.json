[
  {
    "label": "Rust: Build",
    "command": "/bin/zsh",
    "args": [
      "-lc",
      "source .esp/export-esp.sh && export PATH=\"$HOME/.cargo/bin:/opt/homebrew/bin:$PATH\" && sh tools/build.sh"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Rust: Flash + Monitor",
    "command": "/bin/zsh",
    "args": [
      "-lc",
      "source .esp/export-esp.sh && export PATH=\"$HOME/.cargo/bin:/opt/homebrew/bin:$PATH\" && sh tools/build.sh && espflash flash --monitor target/xtensa-esp32s3-espidf/debug/xiao-esp32s3-camera"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Rust: Serial Monitor",
    "command": "/bin/zsh",
    "args": [
      "-lc",
      "export PATH=\"/opt/homebrew/bin:$PATH\" && espflash monitor"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Rust: Format",
    "command": "/bin/zsh",
    "args": [
      "-lc",
      "export PATH=\"/opt/homebrew/opt/rustup/bin:$PATH\" && cargo fmt --all"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Camera: USB Status",
    "command": "python3",
    "args": [
      "tools/camera.py",
      "status"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Camera: USB Verify",
    "command": "python3",
    "args": [
      "tools/camera.py",
      "verify"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Camera: Wi-Fi Setup",
    "command": "python3",
    "args": [
      "tools/camera.py",
      "wifi-setup"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Display: Test picture",
    "command": "python3",
    "args": [
      "tools/camera.py",
      "display-test"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Display: GitHub activity",
    "command": "python3",
    "args": [
      "tools/camera.py",
      "display-github"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Display: GitHub setup",
    "command": "python3",
    "args": [
      "tools/camera.py",
      "github-setup"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]
