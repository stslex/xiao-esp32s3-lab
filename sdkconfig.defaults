# XIAO ESP32-S3 Sense: 8 MB QIO flash and 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Camera frames live in PSRAM; a single QVGA JPEG buffer keeps the first build
# deliberately small and stable.
CONFIG_CAMERA_PSRAM_DMA=n

# esp-idf-hal 0.46 uses ESP-IDF's legacy I2C API. Keep the camera SCCB bus on
# the same driver family so ESP-IDF does not link both mutually exclusive I2C
# implementations into the firmware.
CONFIG_SCCB_HARDWARE_I2C_DRIVER_LEGACY=y
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=n

# Useful headroom for Rust, Wi-Fi and the HTTP handler.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
